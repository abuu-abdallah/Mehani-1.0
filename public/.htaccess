# Mehani Sudan - Apache / InfinityFree PWA MIME & Cache Rules
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest .json
  AddType application/javascript .js .mjs
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|manifest\.json|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
